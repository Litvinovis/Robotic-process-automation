#include "SMMlibrary.cms"

DEFINE($var, 0)
DEFINE($var2, 0)
DEFINE($var3, 0)
DEFINE($post, 0)

LCLICK(546,302)           // начало выкладования новостей в группу
WAITMS(RND(1501, 1700))
LCLICK(844,183)
WAITMS(RND(2501, 2900))
LCLICK(808,303)				// заходим в группу
WAITMS(RND(2501, 2900))   
LCLICK(797,531)
WAITMS(RND(2501, 2900))
LCLICK(692,609)
$var2 = 0
WHILE($var2 < 5)
   INC($var2, 1)
   VKGroupPost($var2)
   LCLICK(51,172)        // возврат наверх страницы
END_CYC       // конец выкладования новостей в группу

vkper:
// Посты по личным страницам (Денис, Артем, Ерик, Рахим, Медет)
$var2 = 0
$var3 = 5
WHILE($var2 < 5)
   INC($var2, 1)
   INC($var3, 1)
   LCLICK(1412,125)
   WAITMS(RND(2001, 2200))
   LCLICK(1256,295)			// выход из профиля
   WAITMS(RND(1001, 1200))
   LCLICK(1343,219)
   WAITMS(1500)
   switch($var2)
   case(1)
      LCLICK(1001,141)      // заходим в профиль Дениса Клочко
      WAITMS(8500)
   case(2)
      LCLICK(893,201)       // заходим в профиль Артема
      WAITMS(10000)
   case(3)
      LCLICK(960,250)       // заходим в профиль Ерика
      WAITMS(10000)
   case(4)
      LCLICK(960,294)       // заходим в профиль Рахима
      WAITMS(10000)
   case(5)
      MOVE(1020,166)
      WAITMS(1500)
      WHEELDOWN
      WAITMS(1500)
      LCLICK(980,161)       // заходим в профиль Медета
      WAITMS(10000)
   end_switch
   VKFriendsAdd()
   LCLICK(546,169)				// переход на "мою страницу"
   VKscroll()
   VKPersonalPost($var2)
   LCLICK(82,287)  // переход наверх страницы
   VKscroll()
   VKPersonalPost($var3)
   VKPersonalLikesUAE()
   vklikes()
END_CYC

WAITMS(RND(1501, 1700))
LCLICK(266,11)
WAITMS(RND(1501, 1700))
LCLICK(959,654)
WAITMS(RND(1501, 1700))
LCLICK(233,19)     // выходим из вк и включаем ФБ
WAITMS(RND(2001, 2500))
SOUND(VK.wav)

fbper:
WAITMS(RND(2001, 2500))
LCLICK(812,426)
FBPersonalPost(1)
LCLICK(812,426)
FBPersonalPost(6)
FBFriendsAdd()
WAITMS(RND(1001, 1200))
LCLICK(278,14) 
WAITMS(RND(1001, 1200))
LCLICK(852,642)  
WAITMS(RND(2001, 2200))
LCLICK(230,18)  // Закрываем ФБ и переходим в ТВ
SOUND(facebook.wav)    // звуковое уведомление о выполении скрипта FB
WAITMS(RND(10001, 11200))

twper:                 // начало первой страницы ТВ
temp:
$var2 = 0
$var3 = 5
WHILE($var2 < 4)
   INC($var2, 1)
   INC($var3, 1)
   TWPersonalPost($var2)
   TWPersonalPost($var3)
   TWFriendsAdd()
   TWSwitchAccount()
END_CYC

WAITMS(RND(1001, 1200))
LCLICK(266,21)
WAITMS(RND(1001, 1200))
LCLICK(357,49)
WAITMS(RND(1001, 1200))
keystring("https://www.instagram.com/?hl=ru", 50)
WAITMS(RND(1001, 1200))
KEYPRESS(#ENTER)
WAITMS(5000)
LCLICK(232,17)  // переходим в инстаграм
WAITMS(RND(1001, 1200))
SOUND(twitter.wav)

igper:
LCLICK(1412,295)  // нажимаем на "Все"
WAITMS(RND(1501, 1900))
$var3 = 0
WHILE($var3 < 3)
   IGScroll()
   IGSubscribe()
   INC($var3, 1)
END_CYC
SOUND(instagram.wav)   // звуковой сигнал о конце в instagram
WAIT(5)

SOUND(end.wav)   // звуковой сигнал о конце работы скрипта
WAIT(3600)   // задержка для остановки работы